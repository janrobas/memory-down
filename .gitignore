/vendor/

# Runtime state (never commit credentials or tokens)
/data/auth/
/data/sessions/
/data/logs/

# Every account's memory, its trash and its disposable search index. This is the
# canonical data store: back it up, never commit it.
/data/users/

# Disposable full-text search index (rebuilt from the Markdown files)
/data/index/

# Local configuration/secrets
/.env

# Local test artifacts
/tests/tmp-run/

# Stray literal "$tmp" directory (e.g. from an unexpanded shell variable)
/$tmp/

# FTP deploy tool (ftp-deploy skill) state - never commit remote layout info.
# The deploy config itself (.ftpdeploy.json) IS committed: it holds no secrets,
# so a fresh clone on any machine knows where to deploy.
/.ftp-deploy/
