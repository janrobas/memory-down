# MemoryDown public directory
# Route every request through the front controller.

Options -Indexes

# Correct MIME types for the on-device model assets (Laya): WASM must be served
# as application/wasm for streaming compilation.
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType text/javascript .mjs
    AddType application/octet-stream .onnx
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Existing files (assets etc.) are served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>
