# If the document root has to point at the project root instead of public_html/,
# deny everything except public_html/ (preferred layout: document root = public_html/).
# This file is a safety net only.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^public_html/ - [L]
    RewriteRule ^$ - [L]
    RewriteRule ^ - [F]
</IfModule>

# Defence in depth: never serve secrets/config even if mod_rewrite is disabled
# or this project root is somehow exposed as the document root.
<FilesMatch "(^\.|\.env($|\.)|\.gitignore$|\.lock$|\.sqlite$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
