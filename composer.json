{
    "name": "memorydown/memorydown",
    "description": "A tiny personal AI memory server: MCP over HTTPS with OAuth 2.1, storing memory as Markdown files. Built for cheap PHP shared hosting.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "league/commonmark": "^2.4",
        "mcp/sdk": "^0.8",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "symfony/uid": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "MemoryDown\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:e2e"
        ],
        "test:unit": "@php tests/unit-tests.php",
        "test:e2e": "@php tests/run-tests.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
