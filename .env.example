# MemoryDown configuration — copy this file to `.env` and fill in values.
# `.env` is git-ignored and never committed.
#
# Values already set in the real environment (hosting panel, php.ini, shell)
# take precedence over this file.

# Public HTTPS base URL of the application, without trailing slash.
APP_BASE_URL=https://memory.example.com

# production | development
APP_ENV=production

# Absolute paths (optional; defaults assume the repository layout).
# Each account's data lives in DATA_PATH/users/<username>/.
# DATA_PATH=/absolute/path/to/data
# USERS_PATH=/absolute/path/to/data/users
# LOG_PATH=/absolute/path/to/data/logs

# Deprecated, migration only: the memory directory a single-user instance used
# before accounts existed. It is read once, on the first boot after upgrading,
# to move that corpus under the first account. Ignored afterwards.
# MEMORY_PATH=/absolute/path/to/data/memory

# Where per-account MCP transport sessions are kept (one directory per account,
# so a session id cannot be replayed against another account).
# MCP_SESSIONS_PATH=/absolute/path/to/data/sessions/mcp

# OAuth token lifetimes in seconds (optional).
# OAUTH_ACCESS_TOKEN_TTL=3600
# OAUTH_REFRESH_TOKEN_TTL=7776000
# OAUTH_CODE_TTL=600

# ---------------------------------------------------------------------------
# Accounts. There is no accounts setting here: accounts live in
# data/auth/users.json and are managed in the admin UI (/ui/users). One
# username and one password per person, used for BOTH the admin UI and the
# OAuth consent page.
#
# The two values below are DEPRECATED seed material, used only when no account
# exists yet (a single-user instance being upgraded). Once an account exists
# they are ignored, so changing a password in the UI sticks.
# ---------------------------------------------------------------------------
# OAUTH_USERNAME=
# OAUTH_CONSENT_PASSWORD=

# Origins whose Client ID Metadata Documents (CIMD) are accepted as a FALLBACK
# when a client presents a URL-formatted client_id (not advertised in discovery;
# clients use DCR by default). Comma-separated.
# OAUTH_CIMD_ALLOWED_ORIGINS=chatgpt.com

# ---------------------------------------------------------------------------
# Web admin UI (browse/search/edit memories at /ui)
# ---------------------------------------------------------------------------

# Enable the admin UI. Set to false to run MCP-only.
# UI_ENABLED=true

# Deprecated seed material: the first admin's password hash, used only when no
# account exists yet. On a fresh install leave it empty and use /ui/setup
# instead — that is where the first account is created. A hash is preferred:
#   php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
# ADMIN_PASSWORD_HASH=

# Optional extra secret required by the first-run /ui/setup form. Recommended
# on a fresh deployment so a stranger cannot claim the instance before you do.
# ADMIN_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Search index (SQLite FTS5). Markdown stays the source of truth; the index is
# disposable, lives inside each account's directory
# (DATA_PATH/users/<username>/index/memory.sqlite) and is rebuilt from the .md
# files whenever it is stale or missing. Requires the pdo_sqlite PHP extension;
# without it the server falls back to direct file search automatically.
# ---------------------------------------------------------------------------

# INDEX_ENABLED=true

# ---------------------------------------------------------------------------
# Public writings API (read-only, token-gated GET at /public/writings).
# Serves entries in the "writings" category that carry `public: true`, as
# Markdown. Disabled by default. The token is NOT configured here: each account
# generates its own in the admin UI under Settings, and the token decides whose
# writings are served. Callers send "Authorization: Bearer <token>".
# ---------------------------------------------------------------------------

# PUBLIC_API_ENABLED=false

# ---------------------------------------------------------------------------
# Workflows API (read-only, token-gated GET at /api/workflows). Serves the
# "workflows" category — the definitions a runner may execute (tagged
# `executable`), plus the drafts and notes beside them — as JSON, including the
# stored Markdown body. Disabled by default. Per-account token from the admin
# UI, exactly like the writings API above.
# ---------------------------------------------------------------------------

# WORKFLOWS_API_ENABLED=false

# ---------------------------------------------------------------------------
# Rate limiting (per client IP, fixed window). Protects the OAuth token and
# consent endpoints, and the admin UI's own password entry points (sign-in and
# first-run setup), on shared hosting. Disable with RATE_LIMIT_ENABLED=false.
# ---------------------------------------------------------------------------

# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_TOKEN_MAX=30
# RATE_LIMIT_CONSENT_MAX=10
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_SETUP_MAX=5
# RATE_LIMIT_WINDOW=60

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

# Send Strict-Transport-Security on every response (max-age one year). Off by
# default: enable only when the deployment is permanently HTTPS, because a
# browser that has seen the header refuses plain HTTP to that host.
# HSTS_ENABLED=false

# Rotate data/logs/app.log once it grows past this many bytes; exactly one
# rotated file (app.log.1) is kept, older content is dropped.
# LOG_MAX_BYTES=5242880
